# ==============================================================================
# Health Prediction Application - Environment Configuration Template
# ==============================================================================
# Copy this file to a new file named '.env' and fill in your actual API key:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
#
# IMPORTANT:
# - Never commit the actual '.env' file to GitHub or share it publicly.
# - The application will run even without an API key by falling back to its
#   built-in local rule-based clinical engine.
# ==============================================================================

# Google Gemini API Key
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
